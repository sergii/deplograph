# Ingestion is disabled until a token is configured.
DEPLOGRAPH_INGEST_TOKEN=replace-with-a-long-random-token
# Optional: enable external OSV matching after imports.
OSV_ENABLED=false
# Optional: only needed for repository inspection.
GITHUB_TOKEN=
# Optional: PostgreSQL connection for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deplograph_development

# PostgreSQL 19 GA Docker tag is not confirmed yet; switch when published.
POSTGRES_IMAGE=postgres:18.7
POSTGRES_PASSWORD=local-development-only
GITHUB_WEBHOOK_SECRET=

# Optional trusted runtime observers. Use distinct, long random tokens per source.
# The generic ingestion token cannot submit artifact.observed events.
DEPLOGRAPH_KUBERNETES_OBSERVER_TOKEN=
DEPLOGRAPH_KAMAL_AGENT_OBSERVER_TOKEN=
DEPLOGRAPH_DOCKER_AGENT_OBSERVER_TOKEN=
DEPLOGRAPH_AWS_ECS_OBSERVER_TOKEN=
