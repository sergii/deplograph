<%= link_to "← Findings register", findings_path, class: "nav-back" %>
<div class="topline">
  <div>
    <div class="eyebrow">Finding #<%= @finding.id %> · <%= @finding.category.humanize %></div>
    <h1><%= @finding.title %></h1>
    <p class="muted"><%= @finding.application.repository_full_name %> · <%= @finding.baseline_environment.name %> → <%= @finding.target_environment.name %></p>
  </div>
  <div class="flex">
    <span class="pill pill-<%= @finding.priority %>"><%= @finding.priority.upcase %></span>
    <span class="pill pill-<%= @finding.status %>"><%= @finding.status.humanize %></span>
  </div>
</div>
<div class="metrics">
  <div class="panel"><div class="muted small">Evidence quality</div><h2><%= @finding.evidence_quality.humanize %></h2></div>
  <div class="panel"><div class="muted small">Severity (operational)</div><h2><%= @finding.severity.humanize %></h2></div>
  <div class="panel"><div class="muted small">First seen</div><h2><%= @finding.first_seen_at.utc.strftime("%d %b %H:%M UTC") %></h2></div>
  <div class="panel"><div class="muted small">Last seen</div><h2><%= @finding.last_seen_at.utc.strftime("%d %b %H:%M UTC") %></h2></div>
</div>
<% if @resolutions.any? %>
  <section class="panel" style="margin-bottom:18px">
    <h2>Verified artifact resolutions</h2>
    <p class="muted small">Cryptographically verified observations are accepted only from owner-approved, scoped control-plane keys and a full pinned workload contract. Trusting the observer's execution environment remains an operator responsibility.</p>
    <% @resolutions.each do |resolution| %>
      <div class="flex" style="padding:11px 0;border-bottom:1px solid #e7edf5">
        <span class="pill pill-same">Verified resolution</span>
        <strong><%= resolution.runtime_attestation.runtime_attestor.name %></strong>
        <span class="muted small"><%= resolution.resolved_at.utc.strftime("%d %b %H:%M UTC") %></span>
        <span class="muted small">
          Signed attestation #<%= resolution.runtime_attestation_id %>,
          verification check #<%= resolution.finding_verification_check_id %>
        </span>
      </div>
    <% end %>
  </section>
<% end %>
<section class="panel" style="margin-bottom:18px">
  <div class="topline">
    <div>
      <h2>Remediation and verification</h2>
      <p class="muted small">A deployed change is reported evidence, not proof that the problem is resolved.</p>
    </div>
    <span class="pill pill-<%= @verification_checks.first&.outcome || "unknown" %>"><%= @verification_checks.first&.outcome&.humanize || "Not checked" %></span>
  </div>
  <div class="grid-two">
    <section>
      <h3>Remediation history</h3>
      <% if @remediations.empty? %>
        <p class="muted small">No remediation has been recorded yet.</p>
      <% else %>
        <% @remediations.each do |attempt| %>
          <div style="border-bottom:1px solid #e7edf5;padding:11px 0">
            <div class="flex">
              <span class="pill"><%= attempt.status.humanize %></span>
              <span class="muted small"><%= attempt.created_at.utc.strftime("%d %b %H:%M UTC") %></span>
            </div>
            <p style="white-space:pre-wrap;margin-top:8px"><%= attempt.description %></p>
            <% if attempt.reference_url.present? %>
              <p><%= link_to "External change reference", attempt.reference_url, target: "_blank", rel: "noopener noreferrer", class: "small" %></p>
            <% end %>
            <div class="muted small">
              <% if attempt.release %>Release #<%= attempt.release_id %> · <% end %>
              <% if attempt.deployment %>Deployment #<%= attempt.deployment_id %> (<%= attempt.deployment.environment.name %>) · <% end %>
              <% if attempt.vulnerability_scan_run %>OSV scan #<%= attempt.vulnerability_scan_run_id %> · <% end %>
              Recorded by <%= attempt.created_by.email %>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if can_triage? %>
        <h3 style="margin-top:21px">Record remediation</h3>
        <%= form_with url: record_finding_remediation_path(@finding), method: :post, local: true do |f| %>
          <div class="stack">
            <div>
              <%= f.label :status, "Remediation state" %>
              <%= f.select :status, [["Planned", "planned"], ["Reported applied (requires deployment or scan)", "reported_applied"], ["Cancelled", "cancelled"]] %>
            </div>
            <div>
              <%= f.label :description, "What changed or is planned?" %>
              <%= f.text_area :description, maxlength: 3000, required: true, placeholder: "Document the intended fix and how to validate it" %>
            </div>
            <div>
              <%= f.label :reference_url, "Change or PR URL (optional)" %>
              <%= f.url_field :reference_url, placeholder: "https://github.com/...", maxlength: 2048 %>
            </div>
            <div>
              <%= f.label :deployment_id, "Deployment evidence (optional)" %>
              <%= f.select :deployment_id, options_for_select(@candidate_deployments.map { |d| ["##{d.id} · #{d.environment.name} · #{d.status}", d.id] }), { include_blank: "No linked deployment" } %>
            </div>
            <div>
              <%= f.label :vulnerability_scan_run_id, "Advisory scan evidence (optional)" %>
              <%= f.select :vulnerability_scan_run_id, options_for_select(@candidate_scans.map { |scan| ["##{scan.id} · #{scan.status} · snapshot #{scan.inventory_snapshot_id}", scan.id] }), { include_blank: "No linked scan" } %>
            </div>
            <div>
              <%= f.label :release_id, "Release (optional)" %>
              <%= f.select :release_id, options_for_select(@candidate_releases.map { |release| ["##{release.id} · #{release.name}", release.id] }), { include_blank: "No linked release" } %>
            </div>
            <%= f.submit "Record remediation", class: "btn btn-primary" %>
          </div>
        <% end %>
      <% end %>
    </section>
    <section>
      <h3>Verification checks</h3>
      <% if @verification_checks.empty? %>
        <p class="muted small">No verification attempted. A fresh comparison after reported remediation is required.</p>
      <% else %>
        <% @verification_checks.each do |check| %>
          <div style="border-bottom:1px solid #e7edf5;padding:11px 0">
            <div class="flex">
              <span class="pill pill-<%= check.outcome %>"><%= check.outcome.humanize %></span>
              <span class="muted small"><%= check.checked_at.utc.strftime("%d %b %H:%M UTC") %></span>
            </div>
            <p class="small"><%= check.reason_code.humanize %></p>
            <p class="muted small">
              <%= link_to "Comparison ##{check.drift_comparison_id}", drift_comparison_path(check.drift_comparison) %> ·
              <%= check.trigger.humanize %> ·
              <%= check.evidence_quality.humanize %> evidence ·
              <%= @resolutions.any? { |resolution| resolution.finding_verification_check_id == check.id } ?
                "Linked signed control-plane evidence" : "Awaiting signed runtime verification" %>
            </p>
          </div>
        <% end %>
      <% end %>
      <% if can_triage? %>
        <h3 style="margin-top:21px">Check against a comparison</h3>
        <%= form_with url: verify_finding_path(@finding), method: :post, local: true do |f| %>
          <div class="stack">
            <div>
              <%= f.label :comparison_id, "Evidence from same application and environment pair" %>
              <%= f.select :comparison_id,
                options_for_select(@candidate_comparisons.map { |comparison|
                  ["##{comparison.id} · #{comparison.mode} · #{comparison.status} · #{comparison.compared_at.utc.strftime("%d %b %H:%M")}", comparison.id]
                }), { include_blank: "Select comparison" }, required: true %>
            </div>
            <%= f.submit "Evaluate evidence", class: "btn btn-primary" %>
          </div>
        <% end %>
      <% end %>
      <p class="muted small" style="margin-top:18px">
        Candidate clear means the issue is no longer present in a fresh, sufficiently complete comparison.
        It does not certify a finished rollout. Only separately approved, signed full-coverage control-plane evidence may resolve artifact drift.
      </p>
    </section>
  </div>
</section>

<div class="grid-two">
  <section class="panel">
    <h2>Evidence and next steps</h2>
    <dl>
      <dt class="muted small">Latest comparison</dt>
      <dd style="margin:4px 0 14px"><%= link_to "Comparison ##{@finding.latest_comparison.id}", drift_comparison_path(@finding.latest_comparison) %></dd>
      <dt class="muted small">Subject</dt>
      <dd style="margin:4px 0 14px"><code><%= @finding.subject %></code></dd>
      <dt class="muted small">Assigned owner</dt>
      <dd style="margin:4px 0 14px"><%= @finding.assigned_to&.email || "Unassigned" %></dd>
      <dt class="muted small">Next action</dt>
      <dd style="margin:4px 0 14px"><%= @finding.next_action.presence || "Not defined" %></dd>
    </dl>
    <p class="muted small">A newer deployment or reported image digest is not proof of remediation. Set verification pending until independent runtime evidence supports resolution.</p>

    <% if can_triage? %>
      <h3>Update finding</h3>
      <%= form_with url: finding_path(@finding), method: :patch, local: true do |f| %>
        <div class="stack">
          <div>
            <%= f.label :status, "Workflow status" %>
            <%= f.select :status, options_for_select(Findings::UpdateFinding::MUTABLE_STATUSES.map { |s| [s.humanize, s] }, @finding.status) %>
          </div>
          <div>
            <%= f.label :assigned_to_id, "Owner" %>
            <%= f.select :assigned_to_id, options_from_collection_for_select(@members, :id, :email, @finding.assigned_to_id), { include_blank: "Unassigned" } %>
          </div>
          <% if can_classify? %>
            <div class="grid-two">
              <div>
                <%= f.label :priority, "Priority" %>
                <%= f.select :priority, options_for_select(DriftFinding::PRIORITIES.map { |p| [p.upcase, p] }, @finding.priority) %>
              </div>
              <div>
                <%= f.label :severity, "Operational severity" %>
                <%= f.select :severity, options_for_select(DriftFinding::SEVERITIES.map { |s| [s.humanize, s] }, @finding.severity) %>
              </div>
            </div>
          <% end %>
          <div>
            <%= f.label :next_action, "Next action" %>
            <%= f.text_area :next_action, value: @finding.next_action, maxlength: 1500, placeholder: "What should happen next?" %>
          </div>
          <div>
            <%= f.label :note, "Decision / investigation note" %>
            <%= f.text_area :note, maxlength: 2000, placeholder: "Evidence, rationale or review notes" %>
          </div>
          <%= f.submit "Save changes", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="panel">
    <h2>Audit trail</h2>
    <% if @history.empty? %>
      <div class="empty">No recorded changes.</div>
    <% else %>
      <div class="timeline">
        <% @history.each do |event| %>
          <div class="event">
            <div class="flex">
              <strong><%= event.action.humanize %></strong>
              <span class="muted small"><time datetime="<%= event.created_at.iso8601 %>"><%= event.created_at.utc.strftime("%d %b %Y %H:%M UTC") %></time></span>
            </div>
            <% if event.actor %><p class="muted small"><%= event.actor.email %></p><% end %>
            <% if event.from_status || event.to_status %>
              <p class="small"><%= event.from_status || "New" %> → <%= event.to_status || "Unchanged" %></p>
            <% end %>
            <% if event.note.present? %><p style="white-space:pre-wrap"><%= event.note %></p><% end %>
            <% if event.drift_comparison %>
              <%= link_to "See comparison ##{event.drift_comparison_id}", drift_comparison_path(event.drift_comparison), class: "small" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <p class="muted small" style="margin-top:20px">Showing the 100 most recent audit events.</p>
  </section>
</div>
