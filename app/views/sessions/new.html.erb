<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in | Deplograph</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; max-width: 420px; margin: 10vh auto; padding: 24px; }
    form { display: grid; gap: 16px; background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; }
    input { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; }
    button { cursor: pointer; background: #0f172a; color: white; padding: 12px; border: none; border-radius: 8px; }
    .error { color: #b91c1c; }
  </style>
</head>
<body>
  <h1>Deplograph</h1>
  <p>Sign in to your organization.</p>
  <%= form_with url: login_path, method: :post do |form| %>
    <% if flash[:alert].present? %><p class="error"><%= flash[:alert] %></p><% end %>
    <div><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "username" %></div>
    <div><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password" %></div>
    <%= form.submit "Sign in" %>
  <% end %>
</body>
</html>
